NODE_ENV=development
HOST=127.0.0.1
PORT=4000
WEB_PORT=5173
DATABASE_URL=file:./dev.db
AGENT_PROVIDER=mock
AGENT_OFFICE_HOOK_TOKEN=
GITHUB_TOKEN=
GITHUB_ORG=
GITHUB_REPOSITORIES=
GITHUB_REPOSITORY_DENYLIST=
POLL_INTERVAL_SECONDS=30
IDLE_THRESHOLD_MINUTES=10
OFFLINE_THRESHOLD_MINUTES=60
ENABLE_DEMO_CONTROLS=true
LOG_LEVEL=info
# Optional override; default is ~/.copilot/session-store.db. Read-only access.
# COPILOT_USAGE_DB_PATH=C:\Users\your-name\.copilot\session-store.db
# VS Code credits/tokens are read (read-only) from chatSessions logs under the VS Code user folder.
# VSCODE_USAGE_TRACKING=true
# VSCODE_USER_DATA_PATH=C:\Users\your-name\AppData\Roaming\Code\User
